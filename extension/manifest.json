{
  "manifest_version": 3,
  "name": "Murmur – Local Read Aloud",
  "version": "1.0.0",
  "description": "Highlight text on any page and have it read aloud by a local Kokoro voice. Pick a voice and adjust the speed.",
  "minimum_chrome_version": "109",
  "permissions": ["contextMenus", "storage", "offscreen", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_title": "Murmur",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+R", "mac": "Alt+R" },
      "description": "Read the selected text aloud"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+P", "mac": "Alt+P" },
      "description": "Pause / resume reading"
    },
    "stop-reading": {
      "suggested_key": { "default": "Alt+S", "mac": "Alt+S" },
      "description": "Stop reading"
    }
  }
}
